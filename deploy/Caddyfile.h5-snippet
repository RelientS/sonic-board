# Inside the h5.tryx402.xyz site block. Keep the site's other subpath routes
# (agent-control, mining, ...) above the final reverse_proxy.

# Static audio assets (WASM, worklets, DI samples) straight from disk. The
# cache is immutable, so worklet files are versioned in audio-engine.ts.
route /audio/* {
	root * /srv/sonic-board/current/public
	header Cache-Control "public, max-age=31536000, immutable"
	encode zstd gzip
	file_server
}

# The app trusts CF-Connecting-IP for per-IP limits. Requests that reach the
# origin without passing through Cloudflare get it overwritten with their real
# peer address so it cannot be forged. Ranges: https://www.cloudflare.com/ips/
@not_cloudflare not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
request_header @not_cloudflare CF-Connecting-IP {remote_host}

reverse_proxy 127.0.0.1:3111
