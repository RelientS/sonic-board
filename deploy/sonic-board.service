[Unit]
Description=Sonic Board web app
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/sonic-board/current
Environment=NODE_ENV=production
# TOKEN_SHARE_KEY (agent model access) and SONIC_DATA_DIR (accounts).
EnvironmentFile=/etc/sonic-board.env
ReadWritePaths=/srv/sonic-board/data
# Run the server directly (not via npm and sh) so systemd signals and
# accounts memory for the node process itself.
ExecStart=/srv/sonic-board/current/node_modules/.bin/vinext start --port 3111 --hostname 127.0.0.1
# The origin also runs other services: keep a runaway process contained.
MemoryHigh=768M
MemoryMax=1G
TasksMax=256
Restart=always
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
